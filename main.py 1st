import socket
from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.dropdown import DropDown

client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
IP_SERVER = "192.168.0.100" 

try:
    client_socket.connect((IP_SERVER, 9999))
except:
    print("Server-ri online miti!")

class PhoneChatApp(App):
    def build(self):
        self.title = "PHONE CHAT"
        self.texts = {
            "Oromo": {
                "title": "📱 PHONE CHAT 📱",
                "status": "Haala: Maaloo koodii mirkaneessaa galchi",
                "btn_verify": "Mirkaneessi",
                "btn_accept": "ACCEPT (Kaasi)",
                "btn_decline": "DON'T ACCEPT (Dhiisi)",
                "invalid": "INVALID CODE (Koodii Dogongora)"
            },
            "English_US": {
                "title": "📱 PHONE CHAT (US) 📱",
                "status": "Status: Please enter verification code",
                "btn_verify": "Verify",
                "btn_accept": "ACCEPT",
                "btn_decline": "DON'T ACCEPT",
                "invalid": "INVALID CODE"
            },
            "English_UK": {
                "title": "📱 PHONE CHAT (UK) 📱",
                "status": "Status: Please enter verification code",
                "btn_verify": "Verify",
                "btn_accept": "ACCEPT",
                "btn_decline": "DON'T ACCEPT",
                "invalid": "INVALID CODE"
            }
        }
        
        self.current_lang = "Oromo"
        self.layout = BoxLayout(orientation='vertical', padding=20, spacing=15)
        
        self.dropdown = DropDown()
        for lang in ["Oromo", "English_US", "English_UK"]:
            btn = Button(text=lang, size_hint_y=None, height=44)
            btn.bind(on_release=lambda btn: self.change_language(btn.text))
            self.dropdown.add_widget(btn)
            
        self.main_lang_btn = Button(text="Afaan / Language", size_hint_y=None, height=40, background_color=(0.2, 0.2, 0.2, 1))
        self.main_lang_btn.bind(on_release=self.dropdown.open)
        self.layout.add_widget(self.main_lang_btn)
        
        self.title_label = Label(text=self.texts[self.current_lang]["title"], font_size=24, size_hint_y=None, height=50)
        self.layout.add_widget(self.title_label)
        
        self.status_label = Label(text=self.texts[self.current_lang]["status"], size_hint_y=None, height=30)
        self.layout.add_widget(self.status_label)
        
        self.code_input = TextInput(hint_text="Code...", size_hint_y=None, height=50, multiline=False, password=True)
        self.layout.add_widget(self.code_input)
        
        self.btn_verify = Button(text=self.texts[self.current_lang]["btn_verify"], background_color=(0, 0.5, 1, 1), size_hint_y=None, height=50)
        self.btn_verify.bind(on_press=self.check_code)
        self.layout.add_widget(self.btn_verify)
        
        self.btn_accept = Button(text=self.texts[self.current_lang]["btn_accept"], background_color=(0, 0.6, 0.3, 1), size_hint_y=None, height=60)
        self.btn_decline = Button(text=self.texts[self.current_lang]["btn_decline"], background_color=(0.8, 0.2, 0.2, 1), size_hint_y=None, height=60)
        
        return self.layout

    def change_language(self, lang_name):
        self.current_lang = lang_name
        self.dropdown.dismiss()
        self.title_label.text = self.texts[lang_name]["title"]
        self.status_label.text = self.texts[lang_name]["status"]
        self.btn_verify.text = self.texts[lang_name]["btn_verify"]
        self.btn_accept.text = self.texts[lang_name]["btn_accept"]
        self.btn_decline.text = self.texts[lang_name]["btn_decline"]

    def check_code(self, instance):
        user_input_code = self.code_input.text
        if user_input_code:
            try:
                client_socket.send(f"VERIFY:{user_input_code}".encode('utf-8'))
                response = client_socket.recv(1024).decode('utf-8')
                
                if response == "SUCCESS":
                    self.status_label.text = "Success! Connected."
                    self.layout.remove_widget(self.code_input)
                    self.layout.remove_widget(self.btn_verify)
                    self.layout.add_widget(self.btn_accept)
                    self.layout.add_widget(self.btn_decline)
                else:
                    self.status_label.text = f"⚠️ {self.texts[self.current_lang]['invalid']}"
            except:
                self.status_label.text = "⚠️ Network Error!"

if __name__ == '__main__':
    PhoneChatApp().run()
